	doi = {10.3389/fpsyg.2022.991345},
	abstract = {In this article, we show that voluntarily inserting devices inside the body is contested and seek to understand why. This article discusses insertables as a source of contestation. To describe and understand the social acceptability, reactions toward, and rhetoric surrounding insertable devices, we examine (i) the technical capabilities of insertable devices (the technical context), (ii) human reactions toward insertables (the social context), and (iii) the regulatory environment. The paper offers explanations to the misperceptions about insertables.},
